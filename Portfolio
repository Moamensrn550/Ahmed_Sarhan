<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Ahmed Sarhan – Graphic Designer</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@200;500;600;800&family=Yellowtail&family=Playfair+Display:wght@900&family=Cairo:wght@900&family=Lexend:wght@300;400&display=swap" rel="stylesheet">
<style>
:root{--red:#8d0c22;--red2:#b0122e;--ink:#111;--bg:#f6f6f6;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html{scroll-behavior:smooth;scroll-padding-top:80px}
*,*:before,*:after{box-sizing:inherit;margin:0}
body{font:300 18px/1.6 Lexend,system-ui,sans-serif;color:var(--ink);background:var(--bg);overflow-x:hidden}
img{max-width:100%;display:block}
.wrap{max-width:1180px;margin:0 auto;padding:0 24px}
h1,h2{font-family:Poppins,sans-serif;font-weight:800;color:var(--red);line-height:1.05}
.sig{font:400 40px Yellowtail,cursive}
.btn{display:inline-flex;align-items:center;gap:8px;border:2px solid var(--red);background:var(--red);color:#fff;padding:13px 28px;border-radius:40px;font:600 15px Poppins,sans-serif;text-decoration:none;cursor:pointer;transition:.25s}
.btn:hover{background:var(--red2);transform:translateY(-3px);box-shadow:0 10px 24px rgba(141,12,34,.35)}
.btn.o{background:transparent;color:var(--red)}
.btn.o:hover{background:var(--red);color:#fff}
.dark .btn.o,.red .btn.o{color:#fff;border-color:#fff}
.dark .btn.o:hover,.red .btn.o:hover{background:#fff;color:var(--red)}
header{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:rgba(246,246,246,.88);backdrop-filter:blur(8px)}
header .wrap{display:flex;align-items:center;justify-content:space-between;height:68px}
nav{display:flex;gap:6px;align-items:center}
nav a{font:500 14px Poppins,sans-serif;color:var(--ink);text-decoration:none;padding:8px 14px;border-radius:30px;transition:.2s}
nav a:hover,nav a.on{background:var(--red);color:#fff}
#bg{display:none;background:none;border:0;font-size:28px;color:var(--red);cursor:pointer}
section{padding:90px 0}
.hero{background:var(--bg);padding:40px 0 0}
.hg{display:grid;grid-template-columns:1.1fr .9fr;gap:20px;align-items:center}
.hero h1{font-size:clamp(64px,10vw,132px);letter-spacing:-3px}
.y{font:900 clamp(36px,5vw,54px) 'Playfair Display',serif;color:var(--ink)}
.ar{font:900 clamp(60px,8vw,104px)/1.3 Cairo,sans-serif;color:var(--red);direction:rtl;text-align:right}
.hero p{margin:14px 0 26px;max-width:460px}
.acts{display:flex;gap:12px;flex-wrap:wrap}
.pt{grid-row:span 2;justify-self:end;width:min(100%,420px);transition:transform .4s}
.pt:hover{transform:rotate(2deg) scale(1.02)}
.pc{width:min(100%,640px);margin-left:-24px;transition:transform .4s}
.pc:hover{transform:translateY(-6px)}
.about{background:#fff}
.ag{display:grid;grid-template-columns:1fr 280px;gap:50px;align-items:center}
.about h2,.skills h2{font-size:clamp(40px,6vw,58px);margin-bottom:24px}
.about p{margin-bottom:18px;font-size:19px}
.stats{display:flex;gap:14px;margin:26px 0}
.st{border:2px solid var(--red);border-radius:18px;padding:14px 22px;text-align:center;transition:.25s}
.st:hover{background:var(--red);color:#fff;transform:translateY(-4px)}
.st b{display:block;font:800 30px Poppins,sans-serif;color:var(--red)}
.st:hover b{color:#fff}
.st span{font-size:13px}
.rings{width:100%}
.skills{background:#fff;padding-top:20px;overflow:hidden}
.sg{display:grid;grid-template-columns:340px 1fr;gap:56px;align-items:center}
.sh{width:340px;transition:transform .4s}
.sh:hover{transform:scale(1.03)}
.sub{font:400 1.15em Yellowtail,cursive;color:var(--ink);font-size:1.15em;margin-left:10px}
.chips{display:flex;flex-wrap:wrap;gap:12px;margin:26px 0 16px}
.chip{border:0;color:#fff;font:600 15px Poppins,sans-serif;padding:12px 22px;border-radius:14px;cursor:pointer;transition:.25s;opacity:.85}
.chip:hover,.chip.on{opacity:1;transform:translateY(-4px) scale(1.05);box-shadow:0 10px 22px rgba(0,0,0,.25)}
#info{min-height:56px;font-size:17px;border-left:4px solid var(--red);padding-left:14px}
.red{background:var(--red);color:#fff;padding-bottom:0}
.red h2{color:#fff;font-weight:200;font-size:clamp(64px,10vw,118px)}
.cg{display:grid;grid-template-columns:1fr 420px;gap:30px;align-items:end}
.cg p{max-width:460px;margin:20px 0 70px;font-size:19px}
.dark{background:var(--ink);color:#fff;text-align:center}
.dark h2{color:#fff;font-size:clamp(36px,6vw,64px)}
.dark p{margin:16px 0 30px;color:#ccc}
.dark .acts{justify-content:center}
footer{background:#000;color:#999;text-align:center;padding:30px 0;font-size:14px}
footer .sig{color:#fff;display:block}
.rv{opacity:0;transform:translateY(30px);transition:opacity .7s,transform .7s}
.rv.in{opacity:1;transform:none}
#up{position:fixed;right:18px;bottom:calc(18px + env(safe-area-inset-bottom,0px));width:46px;height:46px;border-radius:50%;border:0;background:var(--red);color:#fff;font-size:20px;cursor:pointer;opacity:0;pointer-events:none;transition:.3s;z-index:20}
#up.s{opacity:1;pointer-events:auto}
#toast{position:fixed;left:50%;bottom:90px;transform:translateX(-50%) translateY(20px);background:#111;color:#fff;padding:12px 22px;border-radius:30px;font:500 14px Poppins,sans-serif;opacity:0;transition:.3s;z-index:30;pointer-events:none;text-align:center}
#toast.s{opacity:1;transform:translateX(-50%)}
@media(max-width:820px){
 #bg{display:block}
 nav{position:absolute;top:68px;left:0;right:0;flex-direction:column;background:#f6f6f6;padding:10px 24px 20px;display:none}
 nav.o{display:flex}
 .hg,.ag,.sg,.cg{grid-template-columns:1fr}
 .pt{grid-row:auto;justify-self:center;order:-1;width:70%}
 .pc{margin:0 auto}
 .ag aside{max-width:240px}
 .sh{width:70%;margin:0 auto}
 .cg img{margin:0 auto;width:80%}
 .cg p{margin-bottom:30px}
 section{padding:60px 0}
}
</style></head><body>

<header><div class="wrap">
 <a class="sig" href="#home" style="color:var(--ink);text-decoration:none">Ahmed</a>
 <button id="bg" aria-label="Menu">☰</button>
 <nav id="nav"><a href="#home">Home</a><a href="#about">About</a><a href="#skills">Skills</a><a href="#clients">Clients</a><a href="#contact" class="btn" style="padding:8px 20px;color:#fff;margin-left:6px">Contact</a></nav>
</div></header>

<main>
<section class="hero" id="home"><div class="wrap hg">
 <div>
  <h1>Portfolio</h1><div class="y">2026</div>
  <p>Graphic designer with 6+ years of experience in advertising and social media.</p>
  <div class="acts"><a class="btn" href="#about">About me</a><a class="btn o" href="#skills">My skills</a></div>
  <div class="ar" style="margin-top:20px">بورتفوليو</div>
 </div>
 <img class="pt" src="data:image/jpeg;base64," alt="Ahmed Sarhan">
 <img class="pc" src="data:image/jpeg;base64," alt="Retro computer showing Portfolio 2026">
</div></section>

<section class="about" id="about"><div class="wrap ag">
 <div class="rv">
  <h2>About Me</h2>
  <p>I’m Ahmed Sarhan, a graphic designer with over 6 years of experience in advertising and social media. I’ve worked on a wide range of projects in Egypt and abroad, especially in Saudi Arabia, delivering work for car companies, restaurants, and cafés.</p>
  <p>I’ve helped found several brands in Egypt, playing a key role in building each brand’s visual identity, from the logo and color palette to its application across marketing materials.</p>
  <p>My work combines creative ideas with professional execution, so the designs I deliver reflect each brand’s personality and connect with its audience in a meaningful way.</p>
  <div class="stats"><div class="st"><b data-n="6">0</b><span>Years+</span></div><div class="st"><b>2</b><span>Countries</span></div><div class="st"><b>3</b><span>Industries</span></div></div>
  <a class="btn" href="#contact">Let’s talk</a>
 </div>
 <aside class="rv"><svg class="rings" viewBox="0 0 320 225" fill="none" stroke="#8d0c22" stroke-width="5"><ellipse cx="160" cy="50" rx="152" ry="38"/><ellipse cx="160" cy="92" rx="152" ry="38"/><ellipse cx="160" cy="135" rx="152" ry="38"/><ellipse cx="160" cy="177" rx="152" ry="38"/></svg></aside>
</div></section>

<section class="skills" id="skills"><div class="wrap sg">
 <img class="sh rv" src="data:image/jpeg;base64," alt="Software shelf">
 <div class="rv">
  <h2>Skills<span class="sub">Summary</span></h2>
  <p>I work professionally with Photoshop, Illustrator, and InDesign, and I produce video edits in CapCut. I use ChatGPT and most AI tools to deliver better work in less time. I also shoot and edit my own footage, so I can take a project from concept to final delivery on my own.</p>
  <div class="chips" id="chips">
   <button class="chip on" style="background:#0b3fd1" data-t="Photoshop – professional daily use for image editing and compositing.">Photoshop</button>
   <button class="chip" style="background:#f58a0b" data-t="Illustrator – professional use for logos and vector work.">Illustrator</button>
   <button class="chip" style="background:#e5168c" data-t="InDesign – professional use for layouts and print.">InDesign</button>
   <button class="chip" style="background:#222" data-t="CapCut – video editing for social and ads.">CapCut</button>
   <button class="chip" style="background:#0f9d6e" data-t="ChatGPT and AI tools – better work in less time.">ChatGPT</button>
  </div>
  <div id="info">Photoshop – professional daily use for image editing and compositing.</div>
 </div>
</div></section>

<section class="red" id="clients"><div class="wrap cg">
 <div class="rv"><h2>Clients</h2><p>Brands I’ve built and worked with across Egypt and Saudi Arabia: cars, restaurants and cafés.</p><a class="btn o" href="#contact">Be the next client</a></div>
 <img class="rv" src="data:image/jpeg;base64," alt="Ahmed with laptop">
</div></section>

<section class="dark" id="contact"><div class="wrap rv">
 <h2>Let’s work together</h2>
 <p>Have a brand or a project in mind? Send me a message.</p>
 <div class="acts"><a class="btn" id="wa" href="#contact">WhatsApp</a><a class="btn o" id="em" href="#contact">Email</a><a class="btn o" id="ig" href="#contact">Behance</a></div>
</div></section>
</main>
<footer><span class="sig">Ahmed</span>© 2026 Ahmed Sarhan</footer>
<button id="up" aria-label="Back to top">↑</button><div id="toast"></div>

<script>
const LINKS={wa:'',em:'',ig:''}; // e.g. wa:'https://wa.me/20XXXXXXXXXX', em:'mailto:you@mail.com', ig:'https://behance.net/you'
const $=s=>document.querySelector(s),toast=$('#toast');
function say(t){toast.textContent=t;toast.classList.add('s');setTimeout(()=>toast.classList.remove('s'),2400)}
for(const k in LINKS){const a=$('#'+k);a.onclick=e=>{if(LINKS[k]){a.href=LINKS[k];a.target='_blank';a.rel='noopener'}else{e.preventDefault();say('Link coming soon')}}}
$('#bg').onclick=()=>$('#nav').classList.toggle('o');
document.querySelectorAll('nav a').forEach(a=>a.addEventListener('click',()=>$('#nav').classList.remove('o')));
document.querySelectorAll('.chip').forEach(c=>c.onclick=()=>{document.querySelectorAll('.chip').forEach(x=>x.classList.remove('on'));c.classList.add('on');$('#info').textContent=c.dataset.t});
$('#up').onclick=()=>scrollTo({top:0,behavior:'smooth'});
const secs=[...document.querySelectorAll('main section')],links=[...document.querySelectorAll('nav a:not(.btn)')];
addEventListener('scroll',()=>{$('#up').classList.toggle('s',scrollY>500);let c=secs[0].id;secs.forEach(s=>{if(s.getBoundingClientRect().top<200)c=s.id});links.forEach(a=>a.classList.toggle('on',a.hash==='#'+c))},{passive:true});
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);const n=e.target.querySelector('[data-n]');if(n){let v=0,t=+n.dataset.n,id=setInterval(()=>{n.textContent=++v;if(v>=t)clearInterval(id)},120)}}}),{threshold:.15});
document.querySelectorAll('.rv').forEach(e=>io.observe(e));
</script></body></html>
